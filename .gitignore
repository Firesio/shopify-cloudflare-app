# Dependencies & build output
node_modules/
dist/
build/
/build
/app/build
/public/build/
/public/_dev
/app/public/build
.cache
/.cache
.wrangler/
.react-router/
/extensions/*/dist

# npm is the only package manager here — a stray yarn/pnpm lockfile silently
# changes what a CI builder installs. package-lock.json IS committed: it is what
# makes the pinned versions reproducible and what `npm ci` needs.
yarn.lock
pnpm-lock.yaml

# Secrets & local env
.dev.vars
.dev.vars.*
# ...except the template README.md tells you to copy. Without this
# negation the line above ignores it, so it never reaches the repo and the
# documented first-run step cannot be performed on a fresh clone.
!.dev.vars.example
.env
.env.*

# Prisma local dev database
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

# Shopify CLI local state
.shopify/*
.shopify.lock

# Local tooling noise
.claude/settings.local.json
.DS_Store
*.log

# Project-isolated Shopify CLI home (scripts/shopify.mjs) — holds a login session
.shopify-home/

# NOTE: worker-configuration.d.ts IS committed on purpose — a fresh fork has to
# typecheck before anyone has run `npm run cf-typegen`. Regenerate it after
# every wrangler.jsonc change.

# GraphQL codegen output
app/types/

# wrangler check startup output
*.cpuprofile
