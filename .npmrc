engine-strict=true

# @firesio packages come from GitHub Packages. The token is a READ-ONLY (read:packages) token in the NPM_TOKEN
# environment variable (locally and as a build variable in Workers Builds / CI). Never write a token into this file.
@firesio:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
