{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopify-cloudflare-app",
  "main": "./workers/app.ts",
  // Do not raise to 2026-11-17 or later without testing: the new module registry becomes the default.
  "compatibility_date": "2026-10-06",
  // nodejs_compat: the Shopify libraries reach for a few Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    // Bound so the Worker can serve a static asset in-process (env.ASSETS.fetch) without a network self-fetch.
    "binding": "ASSETS"
  },
  // redact_query_string: an embedded request carries `id_token` and `hmac` in its query string.
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true },

  // BINDINGS ARE NOT INHERITED by a named environment: every binding below is declared again under `env.production`
  // (main, compatibility_*, assets and the `$schema` are inherited). `app/test/wrangler-bindings.test.ts` compares the two
  // lists by binding name, so a binding added to one and forgotten in the other fails `npm run verify`.
  //
  // The top level is for Miniflare only (`npm run dev`, vitest): it simulates each binding by NAME and ignores the ids.
  // Never run a `--remote` command against it.

  // Every tick drains the portal outbox and, in development, also runs the daily work (core/cron.ts).
  "triggers": { "crons": ["*/5 * * * *"] },

  "queues": {
    "producers": [
      // Verified webhooks, one durable message each (the request writes nothing to D1).
      { "binding": "WEBHOOK_QUEUE", "queue": "shopify-webhooks" },
      // Events for the portal (docs/architecture.md section 4). The outbox drains into it. The DLQ
      // (portal-events-dlq) is the portal's CONSUMER side: nothing to declare here.
      { "binding": "PORTAL_EVENTS", "queue": "portal-events" }
    ],
    "consumers": [
      { "queue": "shopify-webhooks", "max_retries": 8, "dead_letter_queue": "shopify-webhooks-dlq" }
    ]
  },

  // SESSION: Shopify sessions. PORTAL_BLOCKLIST: the portal's blocklist and kill switch (READ ONLY here; the id is the
  // portal's namespace, a placeholder locally).
  "kv_namespaces": [
    { "binding": "SESSION", "id": "0000000000000000000000000000000d" },
    { "binding": "PORTAL_BLOCKLIST", "id": "0000000000000000000000000000000e" }
  ],

  "send_email": [{ "name": "EMAIL" }],

  // All app state. Migrations are generated by drizzle-kit into ./drizzle (the libraries' /d1 schemas are in drizzle.config.ts).
  "d1_databases": [
    { "binding": "DB", "database_name": "app-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }
  ],

  // Support ticket attachments (screenshots, recordings), streamed to R2.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "app-support-uploads" }],

  // Workers AI (the support spam check). Not simulated by Miniflare; `remote: true` states what is already the case.
  "ai": { "binding": "AI", "remote": true },

  // Rate Limiting bindings (docs/architecture.md section 6.4): one per purpose, named <PURPOSE>_LIMITER. A binding that
  // is absent or errors DENIES (the anti-abuse path fails closed).
  "ratelimits": [
    { "name": "SUPPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SUPPORT_FORM_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "SUPPORT_MAIL_LIMITER", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } }
  ],

  // Secret NAMES, declared rather than inferred (values never live here): so `wrangler types` does not depend on .dev.vars.
  "secrets": {
    "required": ["SHOPIFY_API_SECRET", "SHOP_CUSTOM_DOMAIN", "ATTACHMENT_TOKEN_SECRET", "EVENT_HASH_SECRET", "PARTNER_API_TOKEN"]
  },

  // Non-secret vars. SHOPIFY_API_KEY is the public client_id; `shopify app dev` injects the real one (vite.config.ts).
  "vars": {
    "SHOPIFY_API_KEY": "",
    "SCOPES": "",
    "SHOPIFY_APP_URL": "http://localhost:3000",
    // The App Store listing handle (apps.shopify.com/<handle>); empty until the app has a listing.
    "SHOPIFY_APP_HANDLE": "",
    // An address on a domain onboarded to Email Sending. Empty = email disabled.
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": "",
    // Where a merchant's support activity is announced (one address; staff routing belongs to the portal). Empty = nobody.
    "STAFF_ALERT_EMAIL": "",
    // The domain support mail lives on when it is not the host of SHOPIFY_APP_URL.
    "SUPPORT_MAIL_DOMAIN": "",
    // Cloudflare Turnstile on the public support form; empty = check off (local development only).
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_SECRET_KEY": "",
    // Optional AI Gateway id; empty = straight to Workers AI.
    "AI_GATEWAY_ID": "",
    // The key id of the HMAC every app and the portal share (EVENT_HASH_SECRET is the secret half).
    "EVENT_HASH_KEY_ID": "",
    // Partner API (Managed Pricing reads): the organization and app ids; PARTNER_API_TOKEN is the secret.
    "PARTNER_ORG_ID": "",
    "PARTNER_APP_ID": ""
  },

  // ─────────────────────────── PRODUCTION ───────────────────────────
  // `wrangler deploy --env production`. Every binding is re-declared in full.
  "env": {
    "production": {
      "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true },
      // Daily (the snapshot, the prune) and every minute (the outbox drain only).
      "triggers": { "crons": ["30 3 * * *", "* * * * *"] },
      "queues": {
        "producers": [
          { "binding": "WEBHOOK_QUEUE", "queue": "shopify-webhooks-prod" },
          { "binding": "PORTAL_EVENTS", "queue": "portal-events-prod" }
        ],
        "consumers": [
          { "queue": "shopify-webhooks-prod", "max_retries": 8, "dead_letter_queue": "shopify-webhooks-dlq-prod" }
        ]
      },
      "kv_namespaces": [
        // Replace with the real ids: `wrangler kv namespace create SESSION`; PORTAL_BLOCKLIST is the portal's blocklist-prod namespace.
        { "binding": "SESSION", "id": "REPLACE_ME" },
        { "binding": "PORTAL_BLOCKLIST", "id": "REPLACE_ME" }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "app-db-prod", "database_id": "REPLACE_ME", "migrations_dir": "drizzle" }
      ],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "app-support-uploads-prod" }],
      "ai": { "binding": "AI" },
      "ratelimits": [
        { "name": "SUPPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SUPPORT_FORM_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
        { "name": "SUPPORT_MAIL_LIMITER", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } }
      ],
      // `secrets` must be specified in every named environment.
      "secrets": {
        "required": ["SHOPIFY_API_SECRET", "SHOP_CUSTOM_DOMAIN", "ATTACHMENT_TOKEN_SECRET", "EVENT_HASH_SECRET", "PARTNER_API_TOKEN"]
      },
      "vars": {
        // The production client_id, from shopify.app.toml.
        "SHOPIFY_API_KEY": "",
        "SCOPES": "",
        // Must match application_url in shopify.app.toml.
        "SHOPIFY_APP_URL": "https://example.com",
        "SHOPIFY_APP_HANDLE": "",
        "EMAIL_FROM": "",
        "EMAIL_FROM_NAME": "",
        "STAFF_ALERT_EMAIL": "",
        "SUPPORT_MAIL_DOMAIN": "",
        "TURNSTILE_SITE_KEY": "",
        "AI_GATEWAY_ID": "",
        "EVENT_HASH_KEY_ID": "",
        "PARTNER_ORG_ID": "",
        "PARTNER_APP_ID": ""
      }
    }
  }
}
