{
  "include": [
    "env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".react-router/types/**/*"
  ],
  // Claude config is not source — keep it out of the typecheck.
  "exclude": [
    "node_modules",
    "build",
    "extensions",
    ".claude"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Zero-cost strictness: the codebase already satisfies all four. Not on
    // yet (existing violations): noUncheckedIndexedAccess (15) and
    // exactOptionalPropertyTypes (69) — see docs/UPGRADING.md.
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // Lets vitest.config.ts import with an explicit .ts extension, which Vite's
    // native config loader requires (legal because noEmit is on).
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    // No baseUrl (deprecated in TS 6) — `paths` resolves relative to this file.
    "paths": {
      "~/*": ["./app/*"]
    },
    // @shopify/polaris-types provides the JSX types for the Polaris web
    // components (`s-page`, `s-button`, …) used in the embedded admin.
    "types": [
      "vite/client",
      "@shopify/polaris-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "rootDirs": [".", "./.react-router/types"]
  }
}
