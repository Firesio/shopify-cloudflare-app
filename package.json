{
  "name": "shopify-cloudflare-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "verify": "npm run cf-typegen:check && npm run typecheck && npm run lint && npm test",
    "precommit": "node scripts/precommit.mjs",
    "dev": "node scripts/shopify.mjs app dev --config dev",
    "predev": "node scripts/predev.mjs",
    "build": "CLOUDFLARE_ENV=production react-router build && node scripts/bundle-budget.mjs && node scripts/ci-release.mjs",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p app/dom",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "node --test \"scripts/**/*.test.mjs\" && vitest run",
    "test:watch": "vitest",
    "test:quick": "vitest run --changed",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "db:migrate": "node scripts/migrate.mjs --remote --env production",
    "cf:build": "npm run verify && npm run build",
    "cf:deploy": "npm run check:placeholders && npm run cf:build && npm run db:migrate && wrangler deploy -c build/server/wrangler.json",
    "shopify": "node scripts/shopify.mjs",
    "config:link:dev": "node scripts/shopify.mjs app config link --config dev",
    "config:link:prod": "node scripts/shopify.mjs app config link",
    "config:use:dev": "node scripts/shopify.mjs app config use shopify.app.dev.toml",
    "config:use:prod": "node scripts/shopify.mjs app config use shopify.app.toml",
    "generate": "node scripts/shopify.mjs app generate --config dev",
    "deploy:dev": "node scripts/shopify.mjs app deploy --config dev",
    "deploy:prod": "node scripts/shopify.mjs app deploy --config shopify.app.toml",
    "env": "node scripts/shopify.mjs app env",
    "check:placeholders": "node scripts/check-placeholders.mjs production",
    "new-app": "node scripts/new-app.mjs"
  },
  "dependencies": {
    "@firesio/app": "^1.5.0",
    "@firesio/portal-contract": "^1.2.0",
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-react-router": "^3.0.2",
    "@shopify/shopify-app-session-storage": "^7.0.1",
    "agents": "^0.33.0",
    "ai": "^7.0.173",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.2",
    "postal-mime": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.18.4",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/cli": "4.9.0",
    "@shopify/polaris-types": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "undici": "^7.29.1"
  }
}
