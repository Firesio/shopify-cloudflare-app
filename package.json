{
  "name": "shopify-cloudflare-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "postinstall": "node scripts/setup-agents.mjs",
    "verify": "npm run typecheck && npm run lint && npm test",
    "precommit": "npm run typecheck && npm run lint",
    "dev": "node scripts/shopify.mjs app dev --config dev",
    "predev": "npm run db:migrate:local && npm run db:seed",
    "dev:local": "react-router dev",
    "predev:local": "npm run db:migrate:local && npm run db:seed",
    "build": "CLOUDFLARE_ENV=production react-router build && node scripts/ci-release.mjs",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "node --test scripts/localhost-port.test.mjs scripts/ci-release/shopify-config-paths.test.mjs scripts/check-placeholders.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:quick": "vitest run --changed",
    "cf-typegen": "wrangler types",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "ai:catalogue": "node scripts/ai-catalogue.mjs",
    "ai:catalogue:check": "node scripts/ai-catalogue.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate.mjs --local --database app-db",
    "db:migrate": "node scripts/migrate.mjs --remote --env production --database app-db-prod",
    "cf:build": "npm run verify && CLOUDFLARE_ENV=production npm run build",
    "cf:deploy": "npm run check:placeholders && npm run cf:build && npm run db:migrate && wrangler deploy -c build/server/wrangler.json",
    "shopify": "node scripts/shopify.mjs",
    "config:link:dev": "node scripts/shopify.mjs app config link --config dev",
    "config:link:prod": "node scripts/shopify.mjs app config link",
    "config:use:dev": "node scripts/shopify.mjs app config use shopify.app.dev.toml",
    "config:use:prod": "node scripts/shopify.mjs app config use shopify.app.toml",
    "generate": "node scripts/shopify.mjs app generate --config dev",
    "deploy:dev": "node scripts/shopify.mjs app deploy --config dev",
    "deploy:prod": "node scripts/shopify.mjs app deploy --config shopify.app.toml",
    "env": "node scripts/shopify.mjs app env",
    "shopify:logout": "node scripts/shopify.mjs auth logout",
    "graphql-codegen": "graphql-codegen",
    "install:skill": "node scripts/install-skills.mjs",
    "test:agent-setup": "node --test scripts/setup-agents.contract.mjs scripts/install-skills.test.mjs",
    "db:seed": "node scripts/seed-admin.mjs",
    "db:seed:uninstalls": "node scripts/seed-uninstall-fixtures.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs production",
    "prepush": "npm run verify",
    "illustrations:search": "node scripts/illustrations-online.mjs search",
    "illustrations:download": "node scripts/illustrations-online.mjs download",
    "docs:polaris:sync": "node scripts/sync-polaris-docs.mjs",
    "docs:shadcn:sync": "node scripts/sync-shadcn-docs.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.139",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-router/dev": "^7.18.4",
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-react-router": "^3.0.2",
    "@shopify/shopify-app-session-storage": "^7.0.1",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.136",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "i18next": "^26.4.2",
    "isbot": "^5.2.2",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "remix-i18next": "^7.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.26",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/cli": "4.9.0",
    "@shopify/polaris-types": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "graphql-config": "^5.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "skills": "^1.7.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@shopify/graphql-codegen": {
      "lodash": "^4.18.1"
    },
    "undici": "^7.29.1"
  }
}
